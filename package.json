{
  "name": "online-exam",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build && npm start",
    "build": "tsc -p tsconfig.build.json",
    "check:worker": "npm run build && node scripts/check-dashboard-worker.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "npm test -- --coverage",
    "check:integration": "node scripts/check-integration.mjs",
    "verify": "npm run test:coverage && npm run check:worker && npm run check:integration",
    "manual:seed": "node --env-file=.env scripts/manual-test.mjs seed",
    "manual:cleanup": "node --env-file=.env scripts/manual-test.mjs cleanup"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "mongoose": "^9.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "mingo": "^7.2.7",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "6.0.3"
  }
}
